{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Next.js development server",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Open in Simple Browser",
      "command": "${input:openSimpleBrowser}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": ["http://localhost:3000"]
    }
  ]
}
